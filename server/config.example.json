{
  "modules": {
    "launcher": {
      "root": "%LOCALAPPDATA%\\my-orchestrator",
      "cli": "C:\\path\\to\\orchestrator.py",
      "cardsApi": "C:\\path\\to\\cards.py",
      "python": "python"
    },
    "teams": {
      "enabled": true,
      "reminders": false,
      "ownerName": "Alex",
      "mail": false,
      "markRead": false,
      "inbound": {
        "enabled": false,
        "cwd": "C:\\code\\my-repo",
        "domains": [
          "example.com"
        ]
      },
      "conversations": {
        "enabled": true,
        "reply": false,
        "mute": []
      }
    },
    "tickets": {
      "pattern": "ABC-\\d{4}"
    },
    "quota": {
      "source": "usage-probe"
    },
    "automations": [
      {
        "id": "cleanup",
        "label": "Cleanup",
        "icon": "🧹",
        "everyMinutes": 60,
        "history": "%LOCALAPPDATA%\\my-cleanup\\history.jsonl",
        "runs": "%LOCALAPPDATA%\\my-cleanup\\runs",
        "cli": "C:\\path\\to\\cleanup.py",
        "python": "python",
        "orders": [
          {
            "id": "dry",
            "label": "Dry run",
            "args": [
              "run",
              "--dry-run"
            ]
          },
          {
            "id": "real",
            "label": "Real run",
            "args": [
              "run"
            ],
            "confirm": "Run a real cleanup now?"
          }
        ]
      }
    ]
  },
  "claudeArgs": "",
  "newSession": {
    "folders": [
      "~\\code\\my-repo"
    ]
  },
  "tagger": {
    "domains": [
      "Billing",
      "Calls",
      "Reporting"
    ],
    "tools": [
      {
        "v": "webapp",
        "re": [
          "^my-app/frontend/",
          "^my-app/backend/"
        ]
      },
      {
        "v": "infra",
        "re": [
          "^\\.github/",
          "^devops/"
        ]
      }
    ],
    "topics": [
      {
        "v": "Billing",
        "re": [
          "/billing/",
          "/invoices?/"
        ]
      },
      {
        "v": "Calls",
        "re": [
          "/calls?/",
          "/telephony/"
        ]
      }
    ],
    "toolsWithoutTopic": [
      "infra"
    ],
    "docs": {},
    "roots": [
      {
        "re": "^.*(?:/code/my-repo|/\\.claude/worktrees/[^/]+)/(.+)$"
      }
    ],
    "worktrees": [
      "/\\.claude/worktrees/([^/]+)"
    ],
    "deepDirs": [
      "my-app/"
    ],
    "genericWords": [
      "my-app"
    ],
    "context": "my-app, an invoicing tool",
    "llmModel": "claude-haiku-5-5",
    "llmQuotaMaxPct": 90
  }
}
